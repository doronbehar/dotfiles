#!/bin/sh

# This is script is needed and used on Windows systems that also use claude
# code within tmux. See e.g `~/.local/share/zsh/login/QOG-SERVER`.

read WIDTH HEIGHT <<EOF
$(tmux display-message -p -t "$TMUX_PANE" '#{pane_width} #{pane_height}')
EOF

# Use the popup_pane_left/popup_pane_top format variables to position the popup
# over the target pane - passing raw numbers to -x/-y here ends up anchoring
# the popup to the top of the window instead.
tmux display-popup \
	-BE \
	-t "$TMUX_PANE" \
	-x '#{popup_pane_left}' -y '#{popup_pane_top}' \
	-w "$WIDTH" -h "$HEIGHT" \
	"nvim '$1'"
